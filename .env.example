# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://splicers_admin:password123@localhost:5432/splicers?schema=public"

# Authentication
JWT_SECRET="replace_with_a_super_secret_jwt_key_for_production"
JWT_EXPIRES_IN="7d"

# File Uploads
UPLOAD_DIR="./uploads"

# Client URL (for CORS)
CLIENT_URL="http://localhost:5173"
